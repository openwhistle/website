[codespell]
skip = .git,./tests/e2e/vendor,.venv,.ruff_cache,.mypy_cache,.pytest_cache,uv.lock,htmlcov,*.woff2,*.ttf,*.png,*.ico,*.svg,*.webp,.superpowers,.serena,.claude,CLAUDE.md,./.release,./_site,./docs/de,./docs-tech/plans,./docs-tech/legal
check-hidden = false
# ist — German text in meta description, docs/de/index.html
# unter — German text in meta description, docs/de/index.html
# oder — German text in meta content, docs/de/index.html
# Foto — German search keyword, docs-tech/seo-marketing.md
# produkt — German URL path segment of a linked vendor page, docs/en/blog/*.html
# alle — German UI string, docs/_data/i18n/de.yml
# titel, caf — German test data and a percent-encoded "café", tests/test_build_site.py
# Tage — German retention periods quoted from the privacy policy, tests/test_legal_pages.py
# Sie, Ende, German month names — German test sentences and quoted German texts,
#   tests/test_docs_prose.py, docs-tech/seo-marketing.md
ignore-words-list = produkt,alle,titel,caf,foto,Titel,Tage,ist,unter,oder,Sie,Ende,Januar,Februar,Juni,Juli,Oktober,Dezember
