<mxfile>
  <diagram name="reporting-routes">
    <mxGraphModel>
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start" value="Hinweis auf einen Verstoß&#xa;im beruflichen Umfeld" style="ow:start" vertex="1" parent="1">
          <mxGeometry x="155" y="0" width="300" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="Freie Wahl, § 7 Abs. 1&#xa;intern bevorzugen, wo es wirkt" style="ow:note" vertex="1" parent="1">
          <mxGeometry x="0" y="300" width="250" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="internal" value="Interne Meldestelle&#xa;des Beschäftigungsgebers" style="ow:step" vertex="1" parent="1">
          <mxGeometry x="0" y="140" width="250" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="external" value="Externe Meldestelle&#xa;BfJ, BaFin, Bundeskartellamt, Land" style="ow:step" vertex="1" parent="1">
          <mxGeometry x="360" y="140" width="250" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="disclose" value="Offenlegung nur unter&#xa;den Bedingungen des § 32" style="ow:end" vertex="1" parent="1">
          <mxGeometry x="360" y="300" width="250" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="e-int" style="ow:edge;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="internal">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-ext" style="ow:edge;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="external">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-gap" value="keine Abhilfe" style="ow:edge-optional;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="internal" target="external">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-11"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-late" value="keine Folgemaßnahme&#xa;in der Frist" style="ow:edge-optional;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="external" target="disclose">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="70" y="0"/>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
