<mxfile>
  <diagram name="reporting-routes">
    <mxGraphModel>
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start" value="Information on a breach&#xa;in a work context" style="ow:start" vertex="1" parent="1">
          <mxGeometry x="155" y="0" width="300" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="Free choice, § 7 Abs. 1&#xa;prefer internal where it works" style="ow:note" vertex="1" parent="1">
          <mxGeometry x="0" y="300" width="250" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="internal" value="Internal reporting office&#xa;of the employer" style="ow:step" vertex="1" parent="1">
          <mxGeometry x="0" y="140" width="250" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="external" value="External reporting office&#xa;BfJ, BaFin, Bundeskartellamt, state" style="ow:step" vertex="1" parent="1">
          <mxGeometry x="360" y="140" width="250" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="disclose" value="Public disclosure only under&#xa;the conditions of § 32" style="ow:end" vertex="1" parent="1">
          <mxGeometry x="360" y="300" width="250" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="e-int" style="ow:edge;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="internal">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-ext" style="ow:edge;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="external">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-gap" value="no remedy" style="ow:edge-optional;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="internal" target="external">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-11"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-late" value="no follow-up&#xa;in time" style="ow:edge-optional;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="external" target="disclose">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="70" y="0"/>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
