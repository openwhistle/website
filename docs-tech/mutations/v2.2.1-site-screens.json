{
  "timeout_seconds": 300,
  "test_groups": {
    "SCREENS": ["tests/test_screenshots.py"]
  },
  "mutations": [
    {
      "id": "SCREENS-FROM-AN-OLDER-RELEASE",
      "file": "tests/test_screenshots.py",
      "old": "    marker = MARKER.read_text(encoding=\"utf-8\") if MARKER.exists() else None\n",
      "new": "    marker = \"0.0.1\\n\"\n",
      "tests": "SCREENS"
    },
    {
      "id": "SCREENS-UNMARKED-FOREVER",
      "file": "tests/test_screenshots.py",
      "old": "        if tuple(int(p) for p in version.split(\".\")) <= _LAST_UNMARKED:\n",
      "new": "        if True:\n",
      "tests": "SCREENS"
    },
    {
      "id": "SCREENS-MARKER-NOT-COMPARED",
      "file": "tests/test_screenshots.py",
      "old": "    if marker.strip() != version:\n",
      "new": "    if False:\n",
      "tests": "SCREENS"
    }
  ]
}
